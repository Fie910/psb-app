                </select>
              </div>
            </div>

            {/* Upload Berkas */}
            <div className={`p-4 rounded-xl border ${isDarkMode ? 'bg-gray-700/30 border-gray-600/50' : 'bg-white/40 border-[#d6c5b3]'}`}>
